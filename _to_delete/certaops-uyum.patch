+    def reasoning_level(self, packs: Iterable[str] = ()) -> str:
+        """Bu tur icin akil yurutme seviyesi: `max(taban, pack override'lari)`.
+
+        Risk skorlamasindaki `max(bildirilen, runtime)` ilkesiyle ayni yonde
+        calisir: bir pack seviyeyi yukseltebilir, hicbir pack dusuremez.
+        Tanimsiz veya gecersiz bir seviye sessizce tabana duser.
+        """
+        base = self.gemini_thinking_level
+        if base not in _REASONING_ORDER:
+            base = "low"
+        best = base
+        overrides = dict(self.reasoning_levels)
+        for pack in packs:
+            candidate = overrides.get(pack, "")
+            if candidate in _REASONING_ORDER and _REASONING_ORDER[candidate] > _REASONING_ORDER[best]:
+                best = candidate
+        return best
+
+
+#: Akil yurutme seviyelerinin siralamasi. Karsilastirma icin tek kaynak.
+_REASONING_ORDER: dict[str, int] = {"low": 0, "medium": 1, "high": 2}
+
+
+def _parse_reasoning_levels(raw: str) -> tuple[tuple[str, str], ...]:
+    """`pack:seviye,pack:seviye` bicimini ayristirir; gecersiz seviyeyi atar."""
+    out: list[tuple[str, str]] = []
+    for part in raw.split(","):
+        if ":" not in part:
+            continue
+        key, _, value = part.partition(":")
+        level = value.strip().lower()
+        if level in _REASONING_ORDER:
+            out.append((key.strip(), level))
+    return tuple(out)
+
 
