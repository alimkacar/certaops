# SAP ABAP Cloud Developer Trial 2025 compatibility-test profile.
# Copy to `.env.abap-trial`; never commit the copy because it contains a password.

APP_ENV=development
SAP_BACKEND=ecc
SAP_SYSTEM_ALIAS=ABAP-TRIAL-2025
SAP_TENANT=001

# Keep the AWS SSM port-forward session open while running acceptance tests.
# The EC2 security group exposes no inbound SAP or SSH ports.
SAP_BASE_URL=https://127.0.0.1:50001
SAP_ALLOWED_HOSTS=127.0.0.1
SAP_CLIENT=001
SAP_VERIFY_SSL=false
SAP_TIMEOUT=60
SAP_ODATA_VERSION=v2
SAP_PAGE_SIZE=100
SAP_MAX_PAGES=10

# Developer Trial credentials. Enter the current password from SAP's official
# image README in the private `.env.abap-trial` copy; do not put it here.
SAP_AUTH_MODE=basic
SAP_USERNAME=DEVELOPER
SAP_PASSWORD=
SAP_DESCRIPTION_LANGUAGE=EN

# Deterministic organization used by config/abap_trial_scenario.json.
SAP_COMPANY_CODE=T100
SAP_PLANT=T110
SAP_PURCH_ORG=T100
SAP_PURCH_GROUP=T01
SAP_CURRENCY=USD
SAP_STORAGE_LOCATION=0001

# Live acceptance starts read-only. The write stage overrides these values only
# after the exact CLI confirmation phrase and still passes sap_tool_sweep's
# independent --allow-write gate.
SAP_DRY_RUN=true
SAP_INTEGRATION_ALLOW_WRITE=0
APPROVAL_THRESHOLD=25000
AGENT_APPROVAL_GATEWAY=local
AGENT_LOCAL_ROLES=PURCHASER,AUDITOR

AGENT_STATE_DIR=./state/abap-trial-acceptance
OUTPUT_DIR=./output/abap-trial-acceptance

# Fixed fixture keys: no expensive discovery scan and no guessed business IDs.
SAP_INTEGRATION_MATERIAL=CERTA-RAW-001
SAP_INTEGRATION_VENDOR=SUP-100
SAP_INTEGRATION_PO=4500001001
SAP_INTEGRATION_INVOICE=5100001001
SAP_INTEGRATION_WBS=PRJ-001
