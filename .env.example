########################################
# Calisma profili
#   development -> guvensiz ayarlar yalniz uyari uretir
#   staging     -> ayni, ama uretim benzeri yapilandirma beklenir
#   production  -> guvensiz yapilandirmada servis BASLAMAZ (fail-fast)
########################################
APP_ENV=development

########################################
# Model saglayicisi (saglayici-bagimsiz katman)
#
# Core runtime hicbir SDK tipini bilmez; saglayici buradan secilir.
#   gemini    -> Google Gemini (varsayilan)
#   anthropic -> Claude (opsiyonel bagimlilik: pip install .[anthropic])
#   fake      -> yalniz testler; uretim profili reddeder
########################################
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-3.7-flash
MODEL_TIMEOUT=90
MODEL_MAX_RETRIES=2

########################################
# Gemini
#
# GEMINI_BACKEND=developer -> Gemini Developer API (gelistirme/kalite)
# GEMINI_BACKEND=vertex    -> Vertex AI (URETIMDE SAP VERISI ICIN ONERILEN)
#
# Gemini 3'te temperature / top_p / top_k / candidate_count KALDIRILDI.
# Adapter bunlari GONDERMEZ; muhakeme butcesi thinking_level ile verilir.
#   low     basit R0/R1 ve tek tool istekleri (varsayilan)
#   medium  cok adimli veya cok domainli istekler (runtime otomatik yukseltir)
#   high    yalniz GEMINI_ALLOW_HIGH_THINKING=true ile
########################################
GEMINI_API_KEY=
GEMINI_BACKEND=developer
GEMINI_THINKING_LEVEL=low
GEMINI_ALLOW_HIGH_THINKING=false

# --- Maliyet tahmini --------------------------------------------------------
# Fiyat girilmezse telemetri maliyet YERINE token sayar (sessizce "0 maliyet"
# gostermemek icin). Asagidaki degerler Gemini 3.7 Flash tanitim fiyatidir ve
# 31 Aralik 2026'da biter; 1 Ocak 2027'den itibaren iki katina cikar
# (1.50 / 7.50). Kendi tarifenizi dogrulayin - bunlar fatura degil tahmindir.
# NOT: muhakeme ("thinking") token'lari CIKTI tarifesinden faturalanir ve
# maliyet hesabina dahildir; /telemetry ciktisinda `tokens.reasoning` olarak
# ayrica gorunur.
MODEL_COST_CURRENCY=USD
MODEL_COST_INPUT_PER_MTOK=0.75
MODEL_COST_OUTPUT_PER_MTOK=3.75

# Pack bazli muhakeme yukseltmesi. Yalniz YUKSELTIR: yanlis yazilmis bir
# override bir yazma yolunu az dusunulmus birakamaz. Bicim: pack:seviye,...
AGENT_REASONING_LEVELS=procurement_write:medium,p2p_finance:medium
# Saglayicinin istek/yaniti saklamasi. SAP verisi icin KAPALI kalmali;
# uretim profili true degerini reddeder.
GEMINI_STORE_INTERACTIONS=false

# GEMINI_BACKEND=vertex icin
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# MODEL_PROVIDER=anthropic icin (opsiyonel; artik ZORUNLU DEGIL)
ANTHROPIC_API_KEY=

AGENT_MAX_TOKENS=8000
# Use-case bazli tool adimi siniri (global 25 yerine).
AGENT_MAX_TOOL_ITERATIONS=12
AGENT_ITERATION_LIMITS=platform:4,master_data:5,procurement_read:7,procurement_write:8,p2p_finance:6,reporting:6

# Modelin katki saglamayacagi sorulari LLM'e HIC gondermeden yerel olarak
# cevaplar (deterministik renderer + dar bir tool allowlist'i).
#   true  -> "MAT-1 stok durumu" gibi sorularda SAP verisi model saglayicisina
#            hic cikmaz; bir LLM round-trip'i de tasarruf edilir.
#   false -> her yanit klasik LLM akisindan gecer.
# Hangi sorularin kapsamda oldugu: GET /health -> direct_answers.shortcuts
AGENT_DIRECT_ANSWERS=true

########################################
# SAP backend secimi
#   mock  -> yerel, gercekci S/4HANA benzeri veri (varsayilan, kurulum gerektirmez)
#   odata -> gercek S/4HANA (OData V4 tercihli, V2 fallback)
#   ecc   -> SAP ECC 6.0 EHP8 (Z-Gateway OData V2, embedded SAP_GWFND 7.50)
#
# Backend degistirmek tool'lari, policy'yi, denetim defterini ve gizlilik
# katmanini ETKILEMEZ; yalniz SAP'a hangi yoldan gidildigini belirler.
########################################
SAP_BACKEND=mock
SAP_SYSTEM_ALIAS=S4-MOCK
SAP_TENANT=100

# Gercek sistem icin (SAP_BACKEND=odata veya ecc)
SAP_BASE_URL=https://s4hana.firma.local:44300
SAP_CLIENT=100
SAP_VERIFY_SSL=true
SAP_TIMEOUT=45
# auto -> hedef sistemde released V4 servisi $metadata ile DOGRULANIR; yoksa
#         deprecated V2 servisine dusulur. Sozlesme hic okunamazsa V4 tercihi
#         korunur (kanitsiz geri dusulmez), yalniz uyari uretilir.
# v2/v4 ile zorlanabilir.
# DIKKAT: SAP_BACKEND=ecc iken v4 GECERSIZDIR. ECC 6.0 EHP8 (NetWeaver 7.50)
# yalniz OData V2 destekler; RAP/V4 icin ABAP 7.53+ gerekir. v2 veya auto kullanin.
SAP_ODATA_VERSION=auto

########################################
# ECC 6.0 EHP8 ornegi (SAP_BACKEND=ecc)
#
# SAP_BACKEND=ecc
# SAP_SYSTEM_ALIAS=ECC-PRD
# SAP_BASE_URL=https://ecc.firma.local:44300
# SAP_ODATA_VERSION=v2
# SAP_ALLOWED_HOSTS=ecc.firma.local
#
# Gereken Z-Gateway servisleri ve ABAP nesneleri:
#   docs/ECC_ABAP_REQUIREMENTS.md
# Hangi servisin hazir oldugunu gormek icin:
#   sap_discover_capabilities (probe=true)
########################################
SAP_PAGE_SIZE=100
SAP_MAX_PAGES=10

########################################
# SAP kimlik dogrulama
#   basic       -> kullanici/parola. YALNIZ yerel gelistirme icin.
#   oauth2      -> client credentials token akisi
#   destination -> SAP BTP Destination servisi (Cloud Connector arkasi dahil)
########################################
#   apikey      -> SAP API Business Hub sandbox (gercek SAP, SALT OKUNUR)
SAP_AUTH_MODE=basic
SAP_USERNAME=RPA_AGENT
SAP_PASSWORD=change-me

########################################
# GERCEK SAP'a karsi kontrat dogrulamasi (ucretsiz, salt okunur)
#
# SAP API Business Hub sandbox'i gercek bir S/4HANA Cloud sistemidir; servis
# yollarini, entity/alan adlarini, $filter/$expand davranisini ve hata
# bicimini DOGRU sekilde dogrular. Yazma denemeleri SAP tarafindan
# reddedilir - yazma yolu icin ayri bir sistem gerekir.
#
#   1. https://api.sap.com adresinde hesap acin
#   2. Profil -> Settings -> Show API Key ile anahtari alin
#   3. Asagidaki uc satiri doldurup calistirin:
#        python scripts/check_real_sap.py
#
# SAP_BACKEND=odata
# SAP_BASE_URL=https://sandbox.api.sap.com/s4hanacloud
# SAP_ALLOWED_HOSTS=sandbox.api.sap.com
# SAP_AUTH_MODE=apikey
# SAP_API_KEY=
# SAP_READ_ONLY=true
# SAP_DRY_RUN=true
# # DIKKAT: sandbox tek kiracilidir, `sap-client` parametresi beklemez.
# # Bos birakilmazsa bazi servisler 400 doner.
# SAP_CLIENT=
# # Sandbox verisi Ingilizcedir; aciklama alani TR arayip bulamazsa ilk dile duser.
# SAP_DESCRIPTION_LANGUAGE=EN
########################################
SAP_API_KEY=
# Sandbox varsayilani "APIKey"; farkli bir gecit kullaniyorsaniz degistirin.
SAP_API_KEY_HEADER=APIKey

# SAP_AUTH_MODE=oauth2 veya destination icin
SAP_OAUTH_TOKEN_URL=
SAP_OAUTH_CLIENT_ID=
SAP_OAUTH_CLIENT_SECRET=
SAP_OAUTH_SCOPE=
SAP_DESTINATION_NAME=
SAP_DESTINATION_SERVICE_URL=

########################################
# Cloud Connector (destination ProxyType=OnPremise)
#
# On-premise bir sisteme BTP'den DOGRUDAN erisilemez; trafik connectivity
# proxy uzerinden gecer. Destination OnPremise bildirip bu alanlar bos ise
# servis sessizce timeout'a dusmek yerine acik hata verir.
########################################
SAP_CONNECTIVITY_PROXY_URL=
SAP_CONNECTIVITY_TOKEN_URL=
SAP_CONNECTIVITY_CLIENT_ID=
SAP_CONNECTIVITY_CLIENT_SECRET=
# Coklu Cloud Connector kurulumunda hedef location.
SAP_CLOUD_CONNECTOR_LOCATION_ID=

# Giden trafik allowlist'i (SSRF ve yanlis sisteme yazma korumasi).
# Virgul ile ayrilir; *.firma.local gibi joker desteklenir. Uretimde ZORUNLU.
SAP_ALLOWED_HOSTS=

########################################
# SAP organizasyon varsayilanlari
########################################
SAP_COMPANY_CODE=1000
SAP_PLANT=1100
SAP_PURCH_ORG=1000
SAP_PURCH_GROUP=R01
SAP_CURRENCY=EUR
SAP_STORAGE_LOCATION=0001

########################################
# Read-only urun kilidi. Varsayilan ve bu surumun tek production-ready profili.
# Mutating tool'lari model/MCP/API listesinden gizler, policy'de reddeder ve
# OData HTTP katmaninda mutasyon isteklerini sokete ulasmadan keser.
########################################
SAP_READ_ONLY=true
# Gelecekteki write paketinin gelistirme testleri icin ikinci kilit.
# SAP_READ_ONLY=true iken false yapilsa bile hicbir SAP yazmasi gerceklesmez.
SAP_DRY_RUN=true
# Bu tutarin uzerindeki talepler dogrulanmis onay kaydi ister (SAP_CURRENCY cinsinden)
APPROVAL_THRESHOLD=25000
# R3/R4 yazma penceresi (HH:MM-HH:MM). Bos = pencere kontrolu yok.
AGENT_WRITE_WINDOW=
# Onay kaydinin gecerlilik suresi (dakika)
AGENT_APPROVAL_TTL_MIN=60

########################################
# Onay gecidi
#   local -> onay /approvals uc noktasindan verilir (gelistirme/pilot)
#   bpa   -> SAP Build Process Automation workflow'undan DOGRULANIR
#            (onaylayan kimligi ve karar BPA'dan okunur, cagiriciya guvenilmez)
# Uretimde SAP_DRY_RUN=false ile 'local' kombinasyonu servisi baslatmaz.
########################################
AGENT_APPROVAL_GATEWAY=local
AGENT_BPA_BASE_URL=
AGENT_BPA_DEFINITION_ID=
AGENT_BPA_TOKEN_URL=
AGENT_BPA_CLIENT_ID=
AGENT_BPA_CLIENT_SECRET=

########################################
# API kimlik dogrulama ve yetkilendirme
#   none          -> kapali. YALNIZ yerel gelistirme; /health uyari verir.
#   static_token  -> principals dosyasindaki token hash'i -> actor eslesmesi
#   oidc          -> IAS/XSUAA JWT dogrulama (pyjwt[crypto] gerekir)
########################################
AGENT_AUTH_MODE=none
AGENT_PRINCIPALS_FILE=./config/principals.json
AGENT_OIDC_ISSUER=
AGENT_OIDC_AUDIENCE=
AGENT_OIDC_JWKS_URL=
AGENT_OIDC_ROLES_CLAIM=groups

# Istek limitleri
AGENT_RATE_LIMIT=30
AGENT_MAX_REQUEST_BYTES=65536
# Tool preview'larinda PII/secret maskeleme
AGENT_MASK_PREVIEWS=true

########################################
# Kalici durum: onay, idempotency, oturum ve audit
# memory -> yalniz surec icinde (test)
# sqlite -> restart ve coklu worker'a dayanikli (varsayilan)
########################################
AGENT_STATE_DIR=./state
AGENT_SESSION_BACKEND=sqlite
AGENT_SESSION_TTL_HOURS=24
AGENT_MAX_SESSIONS=500
AGENT_EVIDENCE_TTL_MIN=120
AGENT_EVIDENCE_MAX=500
# Audit kayitlarinin okunabilir JSONL kopyasi. Zincirin dogruluk kaynagi
# durum veritabanidir; bu yalniz dis log toplayicilar icin aynadir.
AGENT_AUDIT_MIRROR=true

########################################
# Sema, tool sonucu ve nihai yanit icin token butcesi guardrail'leri
########################################
BUDGET_SCHEMA_TOKENS=3000
BUDGET_RESULT_TOKENS=1200
BUDGET_TURN_RESULT_TOKENS=6000
BUDGET_ANSWER_TOKENS=1200
BUDGET_KEEP_FULL_RESULTS=6

########################################
# Yerel kanal (CLI/demo) actor'u
# Yerel olmak yazma yetkisi vermez: R3/R4 islemler yine onay kaydi ister.
########################################
AGENT_LOCAL_SUBJECT=local-operator
AGENT_LOCAL_ROLES=VIEWER,PURCHASER

########################################
# Cikti
########################################
OUTPUT_DIR=./output
LOG_LEVEL=INFO

########################################
# Loglama
#
# Log, denetim defterinin (core/audit) yerine GECMEZ: audit "ne yapildi"
# sorusunun hukuki cevabidir, log teshis kaydidir. Ama teshis kaydi da hassas
# veri tasir. Her satir correlation/execution/tenant baglamini tasir ve
# maskeleme diske YAZILMADAN once uygulanir.
########################################
# text -> insan okunur konsol satiri | json -> log toplayici icin tek satir
LOG_FORMAT=text
# E-posta, IBAN, kart ve secret desenlerini maskele. Uretimde false OLAMAZ.
LOG_MASK=true
# Arayuzun /logs ucunun okudugu dairesel tampon (0 -> tampon kurulmaz).
LOG_BUFFER_SIZE=500
# Bos ise dosyaya yazilmaz (container'da stdout/stderr toplanir).
# Doluysa JSON satirlari donerek saklanir.
LOG_FILE=
LOG_FILE_MAX_BYTES=5242880
LOG_FILE_BACKUP_COUNT=3

########################################
# Operator arayuzu (/ui)
#
# API ile ayni origin'den servis edilir: CORS acilmaz, token baska bir
# kaynaga gitmez. Arayuz YENI YETKI TANIMLAMAZ; /logs ve /audit/recent
# `audit.read` kapsami ister. Kapaliyken bu uclar hic kayitli olmaz (404).
# Varsayilan: uretim disinda acik, uretimde bilincli opt-in.
########################################
AGENT_UI_ENABLED=true
AGENT_UI_LOG_STREAM=true
AGENT_UI_MAX_PAGE_SIZE=200

########################################
# Veri gizliligi ve model-oncesi veri koruma
#
# DLP model cagrisindan ONCE calisir. `enforce` disindaki modlar yalniz
# gelistirme icindir; uretim profili `enforce` disini reddeder.
#   enforce -> kararlar uygulanir (allow/mask/tokenize/drop/deny)
#   report  -> bulgu uretilir, payload degistirilmez
#   off     -> devre disi
########################################
AGENT_DLP_MODE=enforce
# Siniflandirilmamis alani D3 kabul et (fail-closed). Uretimde her zaman acik.
AGENT_STRICT_UNKNOWN_FIELDS=false
# Takma kimlik (HMAC) anahtari. Uretimde KMS/secret manager referansi verin;
# tanimsizsa token'lar her restart'ta degisir ve audit korelasyonu kirilir.
AGENT_PSEUDONYMIZATION_KEY_ID=
# AGENT_PSEUDONYMIZATION_SECRET yalniz pilotta; uretimde KMS kullanin.
AGENT_PSEUDONYMIZATION_SECRET=
# KMS anahtar KIMLIGI (denetim izi icin). Anahtarin KENDISI degildir.
AGENT_KMS_KEY_ID=
# Diskteki kanit, oturum ve audit kayitlarinin AES-256-GCM sifrelemesi.
#
# DIKKAT: bu bayraklar FAIL-CLOSED'dur. `true` yapip AGENT_AT_REST_KEY
# vermezseniz servis ACILMAZ. Bilerek boyle: acik gorunup hicbir sey yapmayan
# bir sifreleme ayari, olmayan bir ayardan daha kotudur - yanlis guven uretir.
AGENT_EVIDENCE_ENCRYPTION=false
AGENT_SESSION_ENCRYPTION=false
# Uretimde zorunludur; SQLite body_json ve audit mirror govdesini sifreler.
AGENT_AUDIT_ENCRYPTION=false
# 32 baytlik simetrik anahtar (base64 ya da hex). Uretimde secret manager'dan
# gelmelidir; .env'de tutulmasi yalniz pilot icindir.
#   python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
AGENT_AT_REST_KEY=
# Rapor/export artifact'inin omru.
AGENT_ARTIFACT_TTL_HOURS=24
# Periyodik saklama temizligi (saniye). 0 -> kapali (uretimde reddedilir).
AGENT_RETENTION_SWEEP_SECONDS=900
# Alan bazli veri politikasi dosyasi (opsiyonel; bos ise kod icindeki envanter).
AGENT_DATA_POLICY_FILE=

########################################
# Yetki ve veri sinifi duyarlı guvenli okuma cache'i
#
# Cache bir performans detayi degil yetki yuzeyidir: anahtar tenant, kapsam
# hash'i, organizasyon ve tool surumunu icerir. D3 veri hicbir kosulda
# cache'lenmez.
########################################
# memory -> surec ici | none -> kapali. Dagitik cache backend'i henuz desteklenmiyor.
AGENT_CACHE_BACKEND=memory
AGENT_CACHE_DEFAULT_TTL_SECONDS=60
AGENT_CACHE_MAX_ENTRIES=500
# Her zaman false. true yapilirsa uretim profili baslamaz.
AGENT_D3_CACHE_ENABLED=false

########################################
# Dinamik ve aciklanabilir islem riski motoru
#
# effective_tier = max(bildirilen_tier, runtime_tier). Runtime degerlendirme
# tabani asla dusuremez; yalnizca yukseltebilir.
#   enforce -> effective_tier uygulanir
#   report  -> skor yalniz audit'e yazilir (gecis donemi)
########################################
AGENT_RISK_SCORING_MODE=enforce
# Bagimsiz salt-okunur dallarda azami paralellik.
AGENT_MAX_PARALLEL_READS=4

# --- Audit zinciri checkpoint'i --------------------------------------------
# Zincir basligi periyodik olarak harici (ideal olarak WORM) bir hedefe
# yazilir. Bos = kapali: zincir yine tutulur, ama defterin kendisi yeniden
# yazilirsa bunu kanitlayacak bagimsiz bir kopya olmaz.
AGENT_AUDIT_CHECKPOINT_PATH=
AGENT_AUDIT_CHECKPOINT_EVERY=100

# --- Operator kapatma anahtari ----------------------------------------------
# Virgulle ayrilmis tool adlari. Kapatilan tool modele HIC gosterilmez ve
# adiyla cagrilirsa policy kapisinda TOOL_DISABLED ile reddedilir. Yeniden
# dagitim gerekmez: bir olay sirasinda tek bir yolu kesmek icindir.
# SAP_DRY_RUN hepsini birden kapatir; bu ise cerrahi mudahaledir.
AGENT_DISABLED_TOOLS=

# --- MCP sunucu cephesi (certaops-mcp) --------------------------------------
# stdio tasimasinda istek basina kimlik dogrulama YOKTUR: actor
# AGENT_LOCAL_SUBJECT/AGENT_LOCAL_ROLES degerlerinden kurulur. Bu yuzden yazma
# tool'lari varsayilan olarak bildirilmez. Acmak islerin gorunur olmasini
# saglar, yazma iznini VERMEZ - global SAP_READ_ONLY kilidi, onay,
# idempotency ve SAP_DRY_RUN kapilari aynen isler. Mevcut release'te bos
# birakin; yalniz gelecekteki, uretim-disinda write testleri icindir.
CERTAOPS_MCP_ALLOW_WRITE=

# --- Tenant profili (sirkete ozgu SAP gercekleri) ---------------------------
# Ayni SAP modulu her sirkette ayni SOZLESMEYE sahiptir; degisen yapilandirmadir:
# hangi belge tipi (NB/ZNB/Z01), hangi alanlar zorunlu (field selection), hangi
# Z-alani ne ise yarar. Bunlar $metadata'dan OKUNAMAZ.
#
# Bu yuzden profil ORTAM DEGISKENI DEGIL, durum veritabaninda tenant basina
# tutulur - cok tenant'li bir kurulumda her tenant'in kendi belge tipi olur.
# Profil tanimlanmamissa SAP standardi davranis surer (belge tipi NB).
#
# Yeni bir sirkete uyum saglamak icin KOD DEGISMEZ, profil degisir.
# Tanimlama arayuzu (API/CLI) bir sonraki adimda gelecek; su an profil
# programatik olarak TenantProfileStore ile yazilir.
