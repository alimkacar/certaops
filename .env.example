########################################
# Calisma profili
#   development -> guvensiz ayarlar yalniz uyari uretir
#   staging     -> ayni, ama uretim benzeri yapilandirma beklenir
#   production  -> guvensiz yapilandirmada servis BASLAMAZ (fail-fast)
########################################
APP_ENV=development

########################################
# Claude API
########################################
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5
AGENT_MAX_TOKENS=8000
AGENT_TEMPERATURE=0.2
# Use-case bazli tool adimi siniri (global 25 yerine).
AGENT_MAX_TOOL_ITERATIONS=12
AGENT_ITERATION_LIMITS=platform:4,master_data:5,procurement_read:7,procurement_write:8,project_finance:6,reporting:6

########################################
# SAP backend secimi
#   mock  -> yerel, gercekci S/4HANA benzeri veri (varsayilan, kurulum gerektirmez)
#   odata -> gercek S/4HANA (OData V4 tercihli, V2 fallback)
########################################
SAP_BACKEND=mock
SAP_SYSTEM_ALIAS=S4-MOCK
SAP_TENANT=100

# Gercek sistem icin (SAP_BACKEND=odata)
SAP_BASE_URL=https://s4hana.firma.local:44300
SAP_CLIENT=100
SAP_VERIFY_SSL=true
SAP_TIMEOUT=45
# auto -> released V4 varsa V4, yoksa V2. v2/v4 ile zorlanabilir.
SAP_ODATA_VERSION=auto
SAP_PAGE_SIZE=100
SAP_MAX_PAGES=10

########################################
# SAP kimlik dogrulama
#   basic       -> kullanici/parola. YALNIZ yerel gelistirme icin.
#   oauth2      -> client credentials token akisi
#   destination -> SAP BTP Destination servisi (Cloud Connector arkasi dahil)
########################################
SAP_AUTH_MODE=basic
SAP_USERNAME=RPA_AGENT
SAP_PASSWORD=change-me

# SAP_AUTH_MODE=oauth2 veya destination icin
SAP_OAUTH_TOKEN_URL=
SAP_OAUTH_CLIENT_ID=
SAP_OAUTH_CLIENT_SECRET=
SAP_OAUTH_SCOPE=
SAP_DESTINATION_NAME=
SAP_DESTINATION_SERVICE_URL=

# Giden trafik allowlist'i (SSRF ve yanlis sisteme yazma korumasi).
# Virgul ile ayrilir; *.firma.local gibi joker desteklenir. Uretimde ZORUNLU.
SAP_ALLOWED_HOSTS=

########################################
# SAP organizasyon varsayilanlari
########################################
SAP_COMPANY_CODE=1000
SAP_PLANT=1100
SAP_PURCH_ORG=1000
SAP_PURCH_GROUP=R01
SAP_CURRENCY=EUR
SAP_STORAGE_LOCATION=0001

########################################
# Yazma guvenlik kapilari
#   true  -> yazma islemleri (satinalma talebi vb.) yalnizca simule edilir.
#            Policy ve onay kontrolleri yine calisir; yalniz SAP cagrisi yapilmaz.
#   false -> onaylanan islemler gercekten SAP'a yazilir
########################################
SAP_DRY_RUN=true
# Bu tutarin uzerindeki talepler dogrulanmis onay kaydi ister (SAP_CURRENCY cinsinden)
APPROVAL_THRESHOLD=25000
# R3/R4 yazma penceresi (HH:MM-HH:MM). Bos = pencere kontrolu yok.
AGENT_WRITE_WINDOW=
# Onay kaydinin gecerlilik suresi (dakika)
AGENT_APPROVAL_TTL_MIN=60

########################################
# Onay gecidi
#   local -> onay /approvals uc noktasindan verilir (gelistirme/pilot)
#   bpa   -> SAP Build Process Automation workflow'undan DOGRULANIR
#            (onaylayan kimligi ve karar BPA'dan okunur, cagiriciya guvenilmez)
# Uretimde SAP_DRY_RUN=false ile 'local' kombinasyonu servisi baslatmaz.
########################################
AGENT_APPROVAL_GATEWAY=local
AGENT_BPA_BASE_URL=
AGENT_BPA_DEFINITION_ID=
AGENT_BPA_TOKEN_URL=
AGENT_BPA_CLIENT_ID=
AGENT_BPA_CLIENT_SECRET=

########################################
# API kimlik dogrulama ve yetkilendirme
#   none          -> kapali. YALNIZ yerel gelistirme; /health uyari verir.
#   static_token  -> principals dosyasindaki token hash'i -> actor eslesmesi
#   oidc          -> IAS/XSUAA JWT dogrulama (pyjwt[crypto] gerekir)
########################################
AGENT_AUTH_MODE=none
AGENT_PRINCIPALS_FILE=./config/principals.json
AGENT_OIDC_ISSUER=
AGENT_OIDC_AUDIENCE=
AGENT_OIDC_JWKS_URL=
AGENT_OIDC_ROLES_CLAIM=groups

# Istek limitleri
AGENT_RATE_LIMIT=30
AGENT_MAX_REQUEST_BYTES=65536
# Tool preview'larinda PII/secret maskeleme
AGENT_MASK_PREVIEWS=true

########################################
# Kalici durum: onay, idempotency, oturum ve audit
# memory -> yalniz surec icinde (test)
# sqlite -> restart ve coklu worker'a dayanikli (varsayilan)
########################################
AGENT_STATE_DIR=./state
AGENT_SESSION_BACKEND=sqlite
AGENT_SESSION_TTL_HOURS=24
AGENT_MAX_SESSIONS=500
AGENT_EVIDENCE_TTL_MIN=120
AGENT_EVIDENCE_MAX=500
# Audit kayitlarinin okunabilir JSONL kopyasi. Zincirin dogruluk kaynagi
# durum veritabanidir; bu yalniz dis log toplayicilar icin aynadir.
AGENT_AUDIT_MIRROR=true

########################################
# Sema, tool sonucu ve nihai yanit icin token butcesi guardrail'leri
########################################
BUDGET_SCHEMA_TOKENS=3000
BUDGET_RESULT_TOKENS=1200
BUDGET_TURN_RESULT_TOKENS=6000
BUDGET_ANSWER_TOKENS=1200
BUDGET_KEEP_FULL_RESULTS=6

########################################
# Yerel kanal (CLI/demo) actor'u
# Yerel olmak yazma yetkisi vermez: R3/R4 islemler yine onay kaydi ister.
########################################
AGENT_LOCAL_SUBJECT=local-operator
AGENT_LOCAL_ROLES=VIEWER,PURCHASER

########################################
# Cikti
########################################
OUTPUT_DIR=./output
LOG_LEVEL=INFO

########################################
# Veri gizliligi ve model-oncesi veri koruma
#
# DLP model cagrisindan ONCE calisir. `enforce` disindaki modlar yalniz
# gelistirme icindir; uretim profili `enforce` disini reddeder.
#   enforce -> kararlar uygulanir (allow/mask/tokenize/drop/deny)
#   report  -> bulgu uretilir, payload degistirilmez
#   off     -> devre disi
########################################
AGENT_DLP_MODE=enforce
# Siniflandirilmamis alani D3 kabul et (fail-closed). Uretimde her zaman acik.
AGENT_STRICT_UNKNOWN_FIELDS=false
# Takma kimlik (HMAC) anahtari. Uretimde KMS/secret manager referansi verin;
# tanimsizsa token'lar her restart'ta degisir ve audit korelasyonu kirilir.
AGENT_PSEUDONYMIZATION_KEY_ID=
# AGENT_PSEUDONYMIZATION_SECRET yalniz pilotta; uretimde KMS kullanin.
AGENT_PSEUDONYMIZATION_SECRET=
# Evidence/session sifreleme anahtari. Kaynak kodda veya .env'de tutulmaz.
AGENT_KMS_KEY_ID=
AGENT_EVIDENCE_ENCRYPTION=false
AGENT_SESSION_ENCRYPTION=false
# Rapor/export artifact'inin omru.
AGENT_ARTIFACT_TTL_HOURS=24
# Periyodik saklama temizligi (saniye). 0 -> kapali (uretimde reddedilir).
AGENT_RETENTION_SWEEP_SECONDS=900
# Alan bazli veri politikasi dosyasi (opsiyonel; bos ise kod icindeki envanter).
AGENT_DATA_POLICY_FILE=

########################################
# Yetki ve veri sinifi duyarlı guvenli okuma cache'i
#
# Cache bir performans detayi degil yetki yuzeyidir: anahtar tenant, kapsam
# hash'i, organizasyon ve tool surumunu icerir. D3 veri hicbir kosulda
# cache'lenmez.
########################################
# memory -> surec ici | none -> kapali. Dagitik cache backend'i henuz desteklenmiyor.
AGENT_CACHE_BACKEND=memory
AGENT_CACHE_DEFAULT_TTL_SECONDS=60
AGENT_CACHE_MAX_ENTRIES=500
# Her zaman false. true yapilirsa uretim profili baslamaz.
AGENT_D3_CACHE_ENABLED=false

########################################
# Dinamik ve aciklanabilir islem riski motoru
#
# effective_tier = max(bildirilen_tier, runtime_tier). Runtime degerlendirme
# tabani asla dusuremez; yalnizca yukseltebilir.
#   enforce -> effective_tier uygulanir
#   report  -> skor yalniz audit'e yazilir (gecis donemi)
########################################
AGENT_RISK_SCORING_MODE=enforce
# Bagimsiz salt-okunur dallarda azami paralellik.
AGENT_MAX_PARALLEL_READS=4
