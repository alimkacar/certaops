# SAP S/4HANA Fully-Activated Appliance (CAL) kabul profili.
# Bu dosyayi `.env.cal` olarak kopyalayin; `.env.cal` git'e eklenmemelidir.

APP_ENV=development
SAP_BACKEND=odata
SAP_SYSTEM_ALIAS=S4-CAL-TRIAL
SAP_TENANT=100

# CAL Connection Details ekranindaki HTTPS/Fiori Web Dispatcher hostu.
# IP yerine sertifikasi dogrulanabilen FQDN kullanin.
SAP_BASE_URL=https://<cal-s4-fqdn>:44301
SAP_ALLOWED_HOSTS=<cal-s4-fqdn>
SAP_CLIENT=100
SAP_VERIFY_SSL=true
SAP_TIMEOUT=30
SAP_ODATA_VERSION=v2
SAP_PAGE_SIZE=100
SAP_MAX_PAGES=5

# Yalniz bu deneme sistemi icin ayri, dar yetkili teknik kullanici olusturun.
SAP_AUTH_MODE=basic
SAP_USERNAME=<cal-api-test-user>
SAP_PASSWORD=
SAP_DESCRIPTION_LANGUAGE=EN

# Fully Activated Appliance ornek verisinin ana istemcisi 100, yaygin US
# organizasyonu 1710'dur. Asama 01/03 bu degerleri canli veride dogrular;
# kendi appliance'iniz farkliysa gercek degerlerle degistirin.
SAP_COMPANY_CODE=1710
SAP_PLANT=1710
SAP_PURCH_ORG=1710
SAP_PURCH_GROUP=001
SAP_CURRENCY=USD
SAP_STORAGE_LOCATION=171A

# Varsayilan kosu kesinlikle yazmaz.
SAP_DRY_RUN=true
SAP_INTEGRATION_ALLOW_WRITE=0
CERTAOPS_MCP_ALLOW_WRITE=
AGENT_DISABLED_TOOLS=
APPROVAL_THRESHOLD=25000
AGENT_APPROVAL_GATEWAY=local
AGENT_LOCAL_ROLES=VIEWER,PURCHASER,AUDITOR

# CAL kabul kanitlarini normal gelistirme durumundan ayir.
AGENT_STATE_DIR=./state/cal-acceptance
OUTPUT_DIR=./output/cal-acceptance

# Otomatik kesif yerine bilinen demo verilerini vermek daha hizli ve kararli.
CAL_MATERIAL=
CAL_VENDOR=
CAL_PO=
CAL_INVOICE=
CAL_WBS=
